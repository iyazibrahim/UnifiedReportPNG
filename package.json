{
  "name": "unified-report-penang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build:dashboard": "npm --prefix dashboard run build",
    "test": "node --test tests/*.test.js",
    "fix:tickets": "node scripts/fix-duplicate-tickets.js",
    "fix:tickets:dry": "node scripts/fix-duplicate-tickets.js --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "grammy": "^1.38.3",
    "mongoose": "^8.18.0"
  }
}
