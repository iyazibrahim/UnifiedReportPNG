PORT=3500
# Local: mongodb://127.0.0.1:27017/unified-report-penang
# Docker Compose overrides this to mongodb://mongo:27017/unified-report-penang
MONGODB_URI=mongodb://127.0.0.1:27017/unified-report-penang
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API (Meta) — paste in Settings or here
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
PUBLIC_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional multi-model router (falls back to OPENROUTER_MODEL for primary)
AI_PRIMARY_MODEL=openai/gpt-4o-mini
AI_STRONG_MODEL=openai/gpt-4o
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
NOMINATIM_USER_AGENT=UnifiedReportPenang/1.0
# Optional: enrich landmark seed via Google Places Nearby (never scrape Maps HTML)
GOOGLE_PLACES_API_KEY=
OPS_USER=ops
OPS_PASSWORD=changeme
JWT_SECRET=change-me-in-production
SETTINGS_ENCRYPTION_KEY=
MOCK_PORTAL_PIN=
# Meta-approved utility template for status updates outside 24h session window
WHATSAPP_STATUS_TEMPLATE_NAME=
